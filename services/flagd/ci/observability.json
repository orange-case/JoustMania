{
  "metadata": {
    "flagSetId": "observability"
  },
  "flags": {
    "metrics_export_interval_ms": {
      "state": "ENABLED",
      "variants": {
        "overkill": 10,
        "realtime": 100,
        "normal": 1000
      },
      "defaultVariant": "normal",
      "targeting": {
        "if": [
          {
            "in": [
              {
                "var": "service"
              },
              [
                "controller-manager-service",
                "game-coordinator-service"
              ]
            ]
          },
          "realtime",
          null
        ]
      }
    },
    "grpc_rpc_spans": {
      "state": "ENABLED",
      "variants": {
        "enabled": true,
        "disabled": false
      },
      "defaultVariant": "enabled"
    },
    "otel_bsp_schedule_delay_millis": {
      "state": "ENABLED",
      "variants": {
        "fast": 500,
        "default": 5000
      },
      "defaultVariant": "default",
      "targeting": {
        "if": [
          {
            "==": [
              {
                "var": "service"
              },
              "controller-manager-service"
            ]
          },
          "fast",
          null
        ]
      }
    },
    "flagservice.propagation_probe": {
      "state": "ENABLED",
      "variants": {
        "none": ""
      },
      "defaultVariant": "none"
    },
    "stowaway.enabled": {
      "state": "ENABLED",
      "variants": {
        "on": true,
        "off": false
      },
      "defaultVariant": "off"
    },
    "stowaway.challenge": {
      "state": "ENABLED",
      "variants": {
        "none": "none",
        "span-rounds": "span-rounds",
        "swing-density": "swing-density",
        "cardinality-bomb": "cardinality-bomb",
        "hostile-wifi": "hostile-wifi",
        "clock-skew": "clock-skew"
      },
      "defaultVariant": "none"
    },
    "stowaway.mode": {
      "state": "ENABLED",
      "variants": {
        "telemetry": "telemetry",
        "players": "players",
        "both": "both"
      },
      "defaultVariant": "telemetry"
    },
    "stowaway.intensity": {
      "state": "ENABLED",
      "variants": {
        "low": 0.25,
        "normal": 1.0,
        "high": 2.0,
        "max": 4.0
      },
      "defaultVariant": "normal"
    },
    "stowaway.span_target": {
      "state": "ENABLED",
      "variants": {
        "10k": 10000,
        "100k": 100000,
        "1m": 1000000
      },
      "defaultVariant": "10k"
    },
    "telemetry.moment_shape": {
      "state": "ENABLED",
      "variants": {
        "span_event": "span_event",
        "span": "span",
        "log_event": "log_event"
      },
      "defaultVariant": "span_event"
    },
    "log_level": {
      "state": "ENABLED",
      "variants": {
        "debug": "debug",
        "info": "info",
        "warning": "warning",
        "error": "error"
      },
      "defaultVariant": "info"
    },
    "debug": {
      "state": "ENABLED",
      "variants": {
        "on": true,
        "off": false
      },
      "defaultVariant": "off"
    }
  }
}
